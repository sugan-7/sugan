# VERTEX Environment Configuration Template
# IMPORTANT: Never commit actual credentials, secrets, or API keys to version control.

# Database (PostgreSQL 16+)
DATABASE_URL=jdbc:postgresql://localhost:5432/vertex_db
DATABASE_USERNAME=vertex_user
DATABASE_PASSWORD=vertex_secret_password

# Cache & Rate Limiting (Redis 7+)
REDIS_URL=redis://localhost:6379

# Authentication & Security
JWT_SECRET=super_secure_256_bit_vertex_jwt_secret_key_minimum_32_chars!
JWT_EXPIRATION_MINUTES=15
JWT_REFRESH_SECRET=super_secure_refresh_vertex_jwt_secret_key_minimum_32_chars!
JWT_REFRESH_EXPIRATION_DAYS=7
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# AI Provider Configuration (Optional for local dry-run)
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL_NAME=gpt-4o-mini

# Cloud Media & Storage (Future Video/Media)
STORAGE_PROVIDER=local
STORAGE_BUCKET=vertex-media
STORAGE_API_KEY=
STORAGE_API_SECRET=

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000
